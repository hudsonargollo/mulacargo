{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mulacargo-docs",
  "account_id": "cb27e1a67198789eb42d11ab90737652",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "routes": [
    { "pattern": "mulacargo.clubemkt.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
